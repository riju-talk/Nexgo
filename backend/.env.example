NODE_ENV=development
PORT=4010
DATABASE_URL=postgres://nexgo:nexgo_local_only@localhost:5432/nexgo
FRONTEND_ORIGIN=http://localhost:3021
SESSION_TTL_DAYS=7

# Development only. Use a unique password; this command is blocked in production.
LOCAL_ADMIN_EMAIL=admin@nexgo.local
LOCAL_ADMIN_PASSWORD=change-this-local-password
LOCAL_ADMIN_NAME="Local Platform Admin"

# Optional overrides for `npm run seed:dev` (master dev logins; blocked in production).
# DEV_ADMIN_EMAIL=dev-admin@nexgo.local
# DEV_ADMIN_PASSWORD=NexgoDevAdmin#2026
# DEV_SELLER_EMAIL=dev-seller@nexgo.local
# DEV_SELLER_PASSWORD=NexgoDevSeller#2026
COURIER_WEBHOOK_SECRET=replace-with-a-32-character-local-webhook-secret
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=nexgo_local
MINIO_SECRET_KEY=nexgo_local_only_change_me
MINIO_BUCKET=nexgo-private

# Development only. 32 random bytes, base64-encoded — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Production replaces this with per-record AWS KMS envelope encryption.
LOCAL_ENCRYPTION_KEY=replace-with-a-base64-32-byte-key

# Bank account encryption key (32-byte hex key)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace-with-a-64-character-hex-key

# Optional: leave unset locally to use the mock Razorpay gateway (matches the
# mock courier adapter pattern). Set all three for real sandbox testing.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=local-development-razorpay-webhook-secret

# Mailpit locally (SMTP on 1025, read mail at http://localhost:8025). Points
# at a real ESP the same way once one exists.
SMTP_HOST=localhost
SMTP_PORT=1025

# Serverless hosting: keep each instance pool small; S3-compatible TLS for object storage.
# DB_POOL_MAX=3
# MINIO_USE_SSL=true
