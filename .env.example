# =====================================================================================
# NEXGO: the ONE env file for the whole stack (backend, worker, frontend build, docker compose).
#   cp .env.example .env     then fill in every value marked REQUIRED.
# .env is git-ignored. Never commit it, never bake it into an image, never paste it in chat.
# In AWS, put these in Secrets Manager / SSM Parameter Store and inject them as the container's environment;
# real environment variables always win over this file.
# Generate secrets:  openssl rand -hex 32      (base64 key:  openssl rand -base64 32)
# =====================================================================================

# ---- Runtime ----------------------------------------------------------------------
NODE_ENV=development                 # development | production (docker compose forces production)
PORT=4010
# REQUIRED in production. The exact origin people open in the browser: CORS allow-list, e-mail links, cookie scope.
FRONTEND_ORIGIN=http://localhost:3021
# true when the API sits behind an ALB / CloudFront / nginx, so client IPs and rate limits are real.
TRUST_PROXY=false
# Swagger UI at the API root. Defaults to on in development, off in production.
# DOCS_ENABLED=false

# ---- Database (REQUIRED) -------------------------------------------------------------
# AWS: the RDS endpoint with ?sslmode=require. Local compose (profile `local`) uses the POSTGRES_* values below.
DATABASE_URL=postgres://nexgo:change-me@localhost:5432/nexgo
# DB_POOL_MAX=12
POSTGRES_DB=nexgo
POSTGRES_USER=nexgo
POSTGRES_PASSWORD=change-me          # only used by the local compose Postgres

# ---- Sessions, cookies, CSRF -----------------------------------------------------------
SESSION_TTL_DAYS=7                   # absolute lifetime of one sign-in
SESSION_IDLE_MINUTES=120             # signed out after this long without activity (the app pings /v1/auth/heartbeat)
# REQUIRED. At least 32 random characters. Signs the CSRF token to the session it belongs to.
CSRF_SECRET=
# Cookies are Secure whenever NODE_ENV=production. Only set false to try the production image on http://localhost.
# COOKIE_SECURE=false

# ---- Encryption at rest (REQUIRED) -----------------------------------------------------
LOCAL_ENCRYPTION_KEY=                # base64 of 32 random bytes (provider credentials)
ENCRYPTION_KEY=                      # 64 hex characters (bank account numbers)

# ---- Payments ------------------------------------------------------------------------
# Leave key id/secret empty in development to use the built-in mock gateway.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=             # REQUIRED, at least 16 characters

# ---- E-mail (registration confirmation, password resets, invites) ---------------------
SMTP_HOST=localhost                  # Mailpit locally (http://localhost:8025). AWS SES: email-smtp.<region>.amazonaws.com
SMTP_PORT=1025                       # SES: 587 (STARTTLS) or 465 with SMTP_SECURE=true
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Sender shown to people. Gmail SMTP only sends as the account in SMTP_USER; SES needs a verified mynexgo.com identity.
MAIL_FROM=NEXGO <no-reply@mynexgo.com>

# ---- Object storage (S3 / MinIO; the AWS SDK reads the AWS_* names itself) -----------------
STORAGE_ENABLED=false
STORAGE_BUCKET=nexgo-private
AWS_REGION=ap-south-1
AWS_ENDPOINT_URL_S3=                 # empty on real AWS S3; http://minio:9000 for the local compose MinIO
AWS_ACCESS_KEY_ID=                   # on ECS/EC2 prefer an IAM role and leave these empty
AWS_SECRET_ACCESS_KEY=

# ---- Couriers and channels -------------------------------------------------------------
COURIER_WEBHOOK_SECRET=              # at least 32 characters, signs courier tracking webhooks
LORRIGO_API_KEY=
LORRIGO_BASE_URL=https://app.lorrigo.com/api/v2
LORRIGO_WEBHOOK_TOKEN=               # at least 24 characters; must equal the token configured at Lorrigo
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# SHOPIFY_PUBLIC_URL=                # defaults to FRONTEND_ORIGIN

# ---- Company details printed on the monthly tax invoice --------------------------------------
COMPANY_NAME=NEXGO Logistics Technologies Pvt. Ltd.
COMPANY_ADDRESS=
COMPANY_GSTIN=
COMPANY_REGD_OFFICE=
COMPANY_BANK_ACCOUNT_NAME=
COMPANY_BANK_NAME=
COMPANY_BANK_ACCOUNT_NO=
COMPANY_BANK_IFSC=
COMPANY_BANK_BRANCH=

# ---- Frontend build (read by `next build` / the frontend image) -------------------------------
# One of the two. BACKEND_URL: the Next server proxies /v1/* to the API (docker: http://backend:4010).
# NEXT_PUBLIC_API_BASE: the browser calls this origin; set it to an empty value if the load balancer already routes /v1/* to the API.
BACKEND_URL=
# NEXT_PUBLIC_API_BASE=http://localhost:4010

# ---- Development-only logins ----------------------------------------------------------------
# The backend creates two fixed dev accounts (see backend/src/lib/devAccounts.ts) when NODE_ENV=development AND
# the database is on this machine. They are refused in production and never shown in the UI.
ENABLE_DEV_ACCOUNTS=true
