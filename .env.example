# Base URL of the NEXGO API (backend/). Must match the origin the API's
# FRONTEND_ORIGIN/CORS allow-list expects to receive requests from.
NEXT_PUBLIC_API_BASE=http://localhost:4010

# Deployed (Vercel): set BACKEND_URL instead of NEXT_PUBLIC_API_BASE so /v1/* is proxied same-origin.
# See docs/VERCEL_DEPLOYMENT.md
# BACKEND_URL=https://your-api.vercel.app
